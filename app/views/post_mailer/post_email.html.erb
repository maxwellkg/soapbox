<% content_for :head do %>
  <%= stylesheet_link_tag "posts", "markdown", media: "all" %>
<% end %>

<% provide :blog_header_as_main_heading, false %>

<div class="post-email-body">
  <%= render "posts/post" %>
</div>

<% content_for :footer do %>
  <hr>
  <p>You received this email because you are subscribed to <%= @blog.title %>. If you no longer wish to receive emails, <%= link_to "unsubscribe here", subscriber_unsubscribe_url(@subscriber) %>.</p>
<% end %>
