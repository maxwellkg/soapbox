<section id="post-admin-notice" class="admin-status-note terminal-card <%= admin_post_status_note_style_class %>">
  <div class="admin-status-note-body">
    <% if @post.draft? %>
      <p>Note: This post is currently a draft.</p>
    <% else %>
      <p>
        Note: This post has been published.
        <%= link_to "View public post", post_path(@post) %>.
      </p>
    <% end %>

    <% if @post.email_status_pending? %>
      <p>Emails are pending and can still be stopped.</p>
    <% elsif @post.email_status_initiated? %>
      <p>Emails for this post have been initiated.</p>
    <% else %>
      <p>Emails have not been started for this post.</p>
    <% end %>
  </div>
</section>
