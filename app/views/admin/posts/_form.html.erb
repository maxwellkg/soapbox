<%= form_with(model: [ :admin, @post ]) do |form| %>
  <% if @post.errors.any? %>
    <section class="admin-form-errors" role="alert">
      <p><%= pluralize(@post.errors.count, "error") %> prevented this post from being saved:</p>
      <ul>
        <% @post.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <fieldset class="admin-fieldset">
    <div class="admin-form-row">
      <%= form.label :title, class: "admin-form-label" %>
      <%= form.text_field :title, required: true, autofocus: true %>
    </div>

    <div class="admin-form-row">
      <%= form.label :slug, class: "admin-form-label" %>
      <%= form.text_field :slug %>
    </div>

    <% if @post.persisted? %>
      <div class="admin-form-row admin-form-row-checkbox">
        <%= form.label :pinned, "Pin post", class: "admin-form-label" %>
        <%= form.check_box :pinned %>
      </div>

      <div class="admin-form-row">
        <%= form.label :summary, class: "admin-form-label" %>
        <%= render "shared/house_toolbar", toolbar_id: "post-summary-toolbar" %>
        <%= form.markdown_area :summary, toolbar: "post-summary-toolbar", class: "post-summary-editor" %>
      </div>

      <div class="admin-form-row">
        <%= form.label :content, class: "admin-form-label" %>
        <%= render "shared/house_toolbar", toolbar_id: "post-content-toolbar" %>
        <%= form.markdown_area :content, toolbar: "post-content-toolbar" %>
      </div>
    <% end %>
  </fieldset>

  <div class="form-actions">
    <%= form.submit admin_post_form_submit_text, class: "btn btn-primary" %>
    <%= link_to "cancel", admin_post_form_cancel_path, class: "btn" %>
  </div>
<% end %>
