<% content_for :title, "(Admin) Posts" %>

<section class="page-actions">
  <%= back_to_admin_link %>
  <%= link_to "new post", new_admin_post_path, class: "btn" %>
</section>

<header class="admin-header">
  <h1>Posts</h1>
</header>

<section class="admin-search-section">
  <%= render "admin/posts/search_form" %>
</section>

<section class="admin-list">
  <% if searching? || admin_posts_filtering? %>
    <p><%= admin_num_matching_posts_text %></p>
  <% end %>

  <% if @posts.any? %>
    <%= render partial: "admin/posts/preview", collection: @posts, as: :post %>
    <%= render_pagination_controls %>
  <% else %>
    <p>No posts yet.</p>
  <% end %>
</section>
