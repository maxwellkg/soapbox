<% content_for :title, "Edit Blog" %>

<section class="page-actions">
  <%= link_to "Back to blog", admin_blog_path, class: "btn" %>
  <%= back_to_admin_link %>
</section>

<header class="admin-header">
  <h1>Edit Blog</h1>
</header>

<%= form_with(model: [ :admin, @blog ]) do |form| %>
  <% if @blog.errors.any? %>
    <section class="admin-form-errors" role="alert">
      <p><%= pluralize(@blog.errors.count, "error") %> prevented this blog from being saved:</p>
      <ul>
        <% @blog.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <fieldset class="admin-fieldset">
    <div class="admin-form-row">
      <%= form.label :title, class: "admin-form-label" %>
      <%= form.text_field :title, required: true, autofocus: true %>
    </div>

    <div class="admin-form-row">
      <%= form.label :subtitle, class: "admin-form-label" %>
      <%= form.text_field :subtitle %>
    </div>

    <div class="admin-form-row">
      <%= form.label :description, class: "admin-form-label" %>
      <%= render "shared/house_toolbar", toolbar_id: "blog-description-toolbar" %>
      <%= form.markdown_area :description, toolbar: "blog-description-toolbar" %>
    </div>

    <div class="admin-form-row">
      <%= form.label :site_image, "Site image", class: "admin-form-label" %>
      <%= form.file_field :site_image, accept: "image/*" %>
      <p class="admin-form-hint">Used in the blog header and favicon.</p>

      <% if @blog.site_image.attached? %>
        <%= image_tag @blog.site_image.variant(resize_to_limit: [ 160, 160 ]), alt: "#{@blog.title} site image", class: "admin-site-image-preview" %>

        <div class="admin-form-row-checkbox">
          <%= form.label :should_remove_site_image, "Remove current site image", class: "admin-form-label" %>
          <%= form.check_box :should_remove_site_image %>
        </div>
      <% end %>
    </div>
  </fieldset>

  <div class="form-actions">
    <%= form.submit "Update blog", class: "btn btn-primary" %>
    <%= link_to "Cancel", admin_blog_path, class: "btn" %>
  </div>
<% end %>
