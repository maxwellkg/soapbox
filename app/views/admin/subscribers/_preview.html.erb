<article id="<%= dom_id(subscriber) %>" class="terminal-card admin-card">
  <div class="admin-card-body">
    <div class="admin-preview-row">
      <header>
        <h2><%= link_to subscriber.email_address, admin_subscriber_path(subscriber) %></h2>
        <p class="admin-meta">
          <span class="admin-label">Status:</span> <%= admin_subscriber_status_text(subscriber) %>
          · <span class="admin-label">Updated:</span> <%= admin_subscriber_updated_at_text(subscriber) %>
        </p>
      </header>

      <div class="admin-actions admin-preview-actions">
        <%= link_to "edit", edit_admin_subscriber_path(subscriber), class: "btn" %>
      </div>
    </div>
  </div>
</article>
