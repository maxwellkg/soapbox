<% content_for :title, @subscriber.email_address %>

<section class="page-actions">
  <%= link_to "Back to subscribers", admin_subscribers_path, class: "btn" %>
  <%= link_to "Manage posts", admin_posts_path, class: "btn" %>
  <%= link_to "Edit", edit_admin_subscriber_path(@subscriber), class: "btn" %>
  <%= admin_subscriber_status_change_button %>
</section>

<header class="admin-header">
  <h1><%= @subscriber.email_address %></h1>
</header>

<section class="admin-meta-block">
  <p><span class="admin-label">Status:</span> <%= admin_subscriber_status_text(@subscriber) %></p>
  <p><span class="admin-label">Updated:</span> <%= admin_subscriber_updated_at_text(@subscriber) %></p>
</section>
