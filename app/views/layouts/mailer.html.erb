<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <%= stylesheet_link_tag "mailer", theme_stylesheet, media: "all" %>
    <%= yield :head %>
  </head>

  <body>
    <table class="email-background" role="presentation" width="100%" border="0" cellspacing="0" cellpadding="0">
      <tr>
        <td class="email-background-cell">
          <main class="email-shell">
            <header class="email-title-header">
              <%= render "posts/email_blog_title" %>
            </header>

            <hr>

            <div class="email-content">
              <%= yield %>
            </div>
          </main>
        </td>
      </tr>
    </table>
  </body>
</html>
