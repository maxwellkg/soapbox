<section class="unsubscribe-confirmation">
  <h1>Unsubscribe from email updates?</h1>

  <p>
    You are about to unsubscribe <%= @subscriber.email_address %>.
  </p>

  <p>
    You can resubscribe anytime from the homepage signup form.
  </p>

  <div class="unsubscribe-confirmation-actions">
    <%= button_to "yes, unsubscribe", subscriber_unsubscribe_path(@subscriber), method: :patch %>
    <%= link_to "cancel", root_path, class: "btn" %>
  </div>
</section>
