<div class="blog-title-header">
  <div class="blog-title-copy">
    <h1 class="blog-title"><%= link_to @blog.title, root_path, class: "blog-title-link" %></h1>

    <% if @blog.subtitle.present? %>
      <p class="blog-subtitle"><%= @blog.subtitle %></p>
    <% end %>
  </div>

  <% if @blog.site_image.attached? %>
    <div class="blog-title-image">
      <%= image_tag @blog.resized_site_image(480), alt: "#{@blog.title} site image" %>
    </div>
  <% end %>
</div>
