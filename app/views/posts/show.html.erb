<% content_for :title, @post.title %>

<section class="page-actions">
  <%= link_to "see all posts", root_path, class: "btn" %>
  <% if authenticated? %>
    <%= link_to "edit post", edit_admin_post_path(@post), class: "btn" %>
  <% end %>
</section>

<header>
  <%= render "blogs/header", as_main_heading: false %>
</header>

<section class="signup-section">
  <%= render "subscribers/signups/form" %>
</section>

<div class="post-wrapper">
  <%= render "posts/post" %>
</div>
