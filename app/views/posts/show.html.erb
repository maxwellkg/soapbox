<% content_for :title, @post.title %>

<section class="admin-post-actions page-actions">
  <%= link_to "see all posts", root_path, class: "btn" %>
  <% if authenticated? %>
    <%= link_to "edit post", edit_admin_post_path(@post), class: "btn" %>
  <% end %>
</section>

<header>
  <%= render "posts/blog_title", blog: @blog %>
</header>

<section class="signup-section">
  <%= render "subscribers/signups/form", signup: @signup %>
</section>

<%= render "posts/post", post: @post %>
