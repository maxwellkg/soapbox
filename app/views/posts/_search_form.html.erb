<%= form_with url: root_path, method: :get do |form| %>
  <fieldset class="search-fieldset">
    <legend>Search posts</legend>
    <div class="search-row">
      <%= form.label :search, "Search posts", class: "invisible" %>
      <%= form.search_field :search, value: search_term, placeholder: "search for a post" %>
      <div class="search-actions">
        <%= form.button "Search", class: "btn btn-primary" %>
      </div>
    </div>
  </fieldset>
<% end %>
