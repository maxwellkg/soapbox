<% content_for :title, @blog.title %>

<header>
  <%= render "blog_title" %>
</header>

<section class="signup-section">
  <%= render "subscribers/signups/form" %>
</section>

<% if @blog.description? %>
  <section id="description">
    <%= @blog.description %>
  </section>
<% end %>

<section class="posts-search-section">
  <%= render "search_form" %>
</section>

<section id="posts">
  <% if search_term.present? %>
    <p><%= pluralize(@posts.count, "matching post") %></p>
  <% end %>

  <% if @posts.any? %>
    <%= render partial: "posts/preview", collection: @posts, as: :post %>
  <% else %>
    <p><%= no_matching_posts_text %></p>
  <% end %>
</section>
